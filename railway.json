{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci && npm run build --workspace @tikerino/client"
  },
  "deploy": {
    "startCommand": "npm run start --workspace @tikerino/server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
