# Copy to .env.local (gitignored) for local runs. All of these have defaults.

# Where the server listens. HOST defaults to 127.0.0.1, which is right on a
# laptop and wrong in a container - nothing outside the container reaches it.
# HOST=0.0.0.0
# PORT=8787

# The audit store.
#
# Unset: answers append to server/data/audit.jsonl. Fine for development and CI,
# not for a deployment - the idempotency index is held in memory, so it is
# correct only while exactly one process is writing.
#
# Set: Postgres, which is what a deployment runs. The schema is created on boot
# and the idempotency rule becomes a unique constraint the database enforces, so
# replicas cannot double-count a resent offline answer. This is a SECRET - it
# carries a password. Provision it through your platform's secret store, never in
# the image or a committed file.
#
# DATABASE_URL=postgres://user:password@host:5432/tikerino
#
# Set to "require" for a managed Postgres that terminates TLS with a certificate
# the container has no root for.
# DATABASE_SSL=require

# Used only by the test suite. When unset, the Postgres audit tests skip.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tikerino_test

# Comma-separated list of allowed CORS origins for the learner API.
# No wildcard is ever used. In same-origin deploys (client served by this server)
# the default dev origins are harmless. In split deploys (VITE_API_BASE_URL set)
# you MUST set this to the actual origin(s) that will call the API, e.g.
# CORS_ORIGINS=https://app.tikerino.example,https://tikerino.example
# Defaults to the Vite dev server origins used by `npm run dev`.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Trust level for X-Forwarded-* headers (affects request.ip for rate limiting).
# 1 (default): trust one proxy hop (Railway edge). Use the real client IP.
# 0: do not trust proxies (request.ip will be the direct peer).
# Set to a number of hops or "true" (same as 1).
# TRUST_PROXY=1
